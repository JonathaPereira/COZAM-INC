# ==============================================================================
# COZAM — Variáveis de Ambiente
# Copie este arquivo para .env ao configurar o ambiente local ou defina no Render
# ==============================================================================

# Porta do servidor HTTP (Render define automaticamente)
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE — Banco de Dados e Autenticação
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase (painel do Supabase: Project Settings > API)
SUPABASE_URL=https://exemplo-seu-projeto.supabase.co

# Chave pública anon (Safe to client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave secreta de serviço (USADA SOMENTE NO BACKEND — NUNCA EXPONHA NO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# String de conexão com o PostgreSQL do Supabase (Project Settings > Database > Connection String > URI)
# Recomendado: modo Transaction Pooler (porta 6543) ou Session (porta 5432)
DATABASE_URL=postgresql://postgres.seu-projeto:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
